[
    {
        "name": "depth_prepass",
        "outputs": [
            { "type": "attachment", "name": "depth", "format": "VK_FORMAT_D32_SFLOAT", "resolution": [1200, 800], "op": "VK_ATTACHMENT_LOAD_OP_CLEAR" }
        ]
    },
    {
        "name": "forward",
        "inputs": [
            { "type": "attachment", "name": "depth" }
        ],
        "outputs": [
            { "type": "attachment", "name": "scene_colour", "format": "VK_FORMAT_R16G16B16A16_SFLOAT", "resolution": [1200, 800], "op": "VK_ATTACHMENT_LOAD_OP_CLEAR" }
        ]
    },

    {
        "name": "motion_blur",
        "inputs":  [
            { "type": "texture", "name": "scene_colour" },
            { "type": "texture", "name": "depth" }
        ],
        "outputs": [
            { "type": "attachment", "name": "scene_mb", "format": "VK_FORMAT_R16G16B16A16_SFLOAT", "resolution": [1200, 800], "op": "VK_ATTACHMENT_LOAD_OP_CLEAR" }
        ]
    },
    {
        "name": "dof_downsample",
        "inputs":  [
            { "type": "texture", "name": "scene_mb" },
            { "type": "texture", "name": "depth" }
        ],
        "outputs": [
            { "type": "attachment", "name": "dof_far", "format": "VK_FORMAT_R16G16B16A16_SFLOAT", "resolution": [600, 400], "op": "VK_ATTACHMENT_LOAD_OP_CLEAR" }
        ]
    },
    {
        "name": "dof_blur",
        "inputs":  [
            { "type": "texture", "name": "dof_far" }
        ],
        "outputs": [
            { "type": "attachment", "name": "dof_far_b", "format": "VK_FORMAT_R16G16B16A16_SFLOAT", "resolution": [600, 400], "op": "VK_ATTACHMENT_LOAD_OP_CLEAR" }
        ]
    },
    {
        "name": "post",
        "inputs":  [
            { "type": "texture", "name": "scene_mb" },
            { "type": "texture", "name": "dof_far_b" }
        ],
        "outputs": [
            { "type": "attachment", "name": "ldr_colour", "format": "VK_FORMAT_B8G8R8A8_SRGB", "resolution": [1200, 800], "op": "VK_ATTACHMENT_LOAD_OP_CLEAR" }
        ]
    }
]
